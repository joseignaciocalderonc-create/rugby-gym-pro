rules_version = '2';
// Reglas de seguridad de Rugby Gym Pro (Firestore → Reglas → pegar y Publicar)
// - Cada persona solo lee y escribe SUS datos.
// - Una cuenta suspendida o eliminada no puede escribir.
// - El dueño (documento en la colección "admins" con su UID) ve la lista y puede suspender, reactivar o eliminar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'active';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'active');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'active');
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;   // solo se crea a mano desde la consola de Firebase
    }
  }
}
